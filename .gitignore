# Node / frontend. Unanchored, so this covers a node_modules at ANY depth and not
# only web/'s: a vitest run from the repo root once left a cache marker in a
# root-level node_modules/, which was outside `web/node_modules/` and so got
# committed by a `git add -A`.
node_modules/
.vite/
web/dist/
web/test-results/
web/playwright-report/

# Runtime data (VAPID keys, subscriptions, uploads)
.kunai/

# TLS material
*.crt
*.key

# Logs / OS
*.log
.DS_Store

# Release binaries at the repo root (NOT internal/webui/dist, which is the
# committed, go:embed'd web build).
/dist/
# The locally-built binary (go build -o kunai); never committed, and it must not
# show up as an untracked "changed file" in the review panel.
/kunai
